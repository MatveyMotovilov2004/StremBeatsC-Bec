<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4cfcbc91-28c6-4c6d-802e-b30457888ce0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
	<PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SharpGrip.FluentValidation.AutoValidation.Mvc" Version="2.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Protos\Track.proto" GrpcServices="Client" />
		<Protobuf Include="..\Protos\upload_track.proto" GrpcServices="Client" />
		<Protobuf Include="..\Protos\Register.proto" GrpcServices="Client" />
		<Protobuf Include="..\Protos\RefreshToken.proto" GrpcServices="Client" />
		<Protobuf Include="..\Protos\authentication.proto" GrpcServices="Client" />
		<Protobuf Include="..\Protos\logout.proto" GrpcServices="Client" />
		<Protobuf Include="..\Protos\give_role.proto" GrpcServices="Client" />
		<Protobuf Include="..\Protos\artist.proto" GrpcServices="Client" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Orchestration\" />
	  <Folder Include="Docker\" />
	</ItemGroup>

	

</Project>
