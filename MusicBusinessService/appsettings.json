{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Jwt": {
    "Issuer": "IdentityInfrastructureAuthentication",
    "Audience": "IdentityApplication",
    "AccessTokenExpirationMinutes": 10,
    "RefreshTokenExpirationDays": 30
  }
}
